{
  "name": "scale-shape",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests package.json tsconfig.json README.md playwright.config.ts",
    "format:check": "prettier --check src tests package.json tsconfig.json README.md playwright.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
